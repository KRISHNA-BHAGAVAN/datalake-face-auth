# AWS sync — set these in .env (Expo loads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_FACE_SYNC_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/prod/face-templates
EXPO_PUBLIC_FACE_SYNC_API_KEY=

# Optional: S3 bucket if your backend docs reference it
EXPO_PUBLIC_AWS_S3_BUCKET=your-datalake-face-templates-bucket